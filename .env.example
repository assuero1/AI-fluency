# AI Fluency environment template
# Copy to .env.local during implementation. Never commit real secrets.

# App
APP_URL=http://localhost:3000
APP_ENV=development
ENCRYPTION_SECRET=replace-with-a-long-random-secret
# Production-only attestation used by the Phase 8 host gate after mounting the volume.
AUDIO_CACHE_PERSISTENT=false

# ========================================================
# TTS (Text to Speech) Configuration
# ========================================================
# Provider: "kokoro" (VPS) or "deepinfra" (Chatterbox Multilingual)
TTS_PROVIDER=kokoro

# Kokoro running on VPS (when TTS_PROVIDER=kokoro)
KOKORO_BASE_URL=https://your-kokoro.example.com
KOKORO_API_KEY=replace-with-kokoro-api-key
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_OUTPUT_FORMAT=mp3
KOKORO_SPEED=1.08
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_ES=ef_dora
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_IT=if_sara
KOKORO_VOICE_PT=pf_dora
KOKORO_VOICE_JA=jf_alpha
KOKORO_VOICE_ZH=zf_xiaobei
KOKORO_VOICE_HI=hf_alpha
# Comma-separated server allowlists. Omit to allow only the defaults above.
KOKORO_ALLOWED_VOICES=af_heart,ef_dora,ff_siwis,if_sara,pf_dora,jf_alpha,zf_xiaobei,hf_alpha
KOKORO_ALLOWED_FORMATS=mp3

# DeepInfra Chatterbox Multilingual (when TTS_PROVIDER=deepinfra)
# DEEPINFRA_API_KEY=your-deepinfra-token
# DEEPINFRA_CHATTERBOX_MODEL=ResembleAI/chatterbox-multilingual
# DEEPINFRA_CHATTERBOX_OUTPUT_FORMAT=mp3
# DEEPINFRA_CHATTERBOX_DEFAULT_VOICE=
# DEEPINFRA_CHATTERBOX_VOICE_PT=
# DEEPINFRA_CHATTERBOX_VOICE_EN=

# Persistent server-side cache for speech responses. Mount this directory as a volume in production.
AUDIO_CACHE_DIR=.audio-cache
AUDIO_CACHE_MAX_MB=200
AUDIO_CACHE_MAX_AGE_DAYS=30

# ========================================================
# AI provider for conversation/correction/recommendations
# ========================================================
# Options: "deepseek", "deepinfra", "openai", "anthropic", "openrouter"
AI_PROVIDER=deepseek

# If AI_PROVIDER=deepseek:
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=replace-with-ai-provider-api-key
AI_CHAT_MODEL=deepseek-chat

# If AI_PROVIDER=deepinfra:
# AI_BASE_URL is optional (defaults automatically to https://api.deepinfra.com/v1/openai)
# AI_BASE_URL=https://api.deepinfra.com/v1/openai
# AI_API_KEY is optional if DEEPINFRA_API_KEY is set above
# AI_CHAT_MODEL=deepseek-ai/DeepSeek-V3

AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1200

# Speech-to-text uses the browser/cellphone native recognition API.
# No STT provider, URL, API key, or model environment variables are required.

# Optional Phase 8 private-origin access header. Keep the value server-only.
PHASE8_ACCESS_HEADER_NAME=
PHASE8_ACCESS_HEADER_VALUE=
FLASHCARD_ACTIVE_RECALL_ENABLED=true

# Optional per-type rollout flags for the smart review card mix (default: enabled).
FLASHCARD_PRODUCTION_ENABLED=true
FLASHCARD_CLOZE_ENABLED=true
FLASHCARD_LISTENING_ENABLED=true

# Supabase (único backend de dados)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (server-only; usada pelo client autenticado por request com RLS)
SUPABASE_ANON_KEY=

# Web push (lembrete de streak): chaves VAPID geradas com
# `npx web-push generate-vapid-keys`. A pública também vai ao cliente
# (NEXT_PUBLIC_VAPID_PUBLIC_KEY); a privada fica server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@ai-fluency.app
# Segredo do header x-cron-secret do endpoint /api/notifications/tick.
NOTIFICATIONS_CRON_SECRET=
